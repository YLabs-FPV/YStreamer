#!/bin/sh
set -e

CONFIG=/boot/firmware/config.txt
BEGIN="# >>> ystreamer"
END="# <<< ystreamer"

remove_boot_settings() {
    [ -f "$CONFIG" ] || return 0
    grep -qF "$BEGIN" "$CONFIG" || return 0
    sed -i "/^$BEGIN\$/,/^$END\$/d" "$CONFIG"
    rm -f "$CONFIG.before-ystreamer"
    echo "YStreamer: restored $CONFIG; reboot to get the USB-C port back." >&2
}

# Left off: what it was before isn't known
radxa_gadget_hint() {
    command -v systemctl >/dev/null 2>&1 || return 0
    units=$(systemctl list-unit-files --no-legend --plain 'radxa-adbd*' 'radxa-ecm*' 'radxa-ncm*' 'radxa-usbnet*' 2>/dev/null | awk '{ print $1 }' | grep -v '@\.service$')
    [ -n "$units" ] || return 0
    echo "YStreamer: Radxa's USB gadget services stay off; to have them back: systemctl enable --now $(echo "$units" | tr '\n' ' ')" >&2
}

case "$1" in
remove)
    remove_boot_settings
    radxa_gadget_hint
    ;;
purge)
    remove_boot_settings
    # Settings and the login; recordings in /var/lib/ystreamer stay
    rm -rf /etc/ystreamer
    ;;
esac

#DEBHELPER#
