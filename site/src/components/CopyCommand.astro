---
import { Icon } from "astro-icon/components";
import { highlightCommand } from "../lib/highlight";
import { getLangFromUrl, useTranslations } from "../i18n";

interface Props {
  command: string;
  class?: string;
}

const { command, class: className } = Astro.props;

// Highlighted at build time with the same themes as the docs' code blocks,
// so global.css picks the colours for the theme in use
const highlighted = await highlightCommand(command);
// Just the tokens of the one line, without Shiki's <pre> and <code>.
// Long URLs may only wrap after a slash, so <wbr> goes after each one in the
// text (never inside a tag)
const tokens = (highlighted.match(/<span class="line">([\s\S]*)<\/span><\/code>/)?.[1] ?? command)
  .replace(/>([^<]*)</g, (_, text: string) => `>${text.replace(/\//g, "/<wbr>")}<`);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class:list={["copy-cmd", className]} data-copy-cmd>
  <span class="copy-prompt" aria-hidden="true">
    $
  </span>
  <code class="copy-text astro-code" set:html={tokens} />
  <button
    type="button"
    class="copy-btn"
    data-copy={command}
    aria-label={t("common.copy")}
    title={t("common.copy")}
  >
    <Icon name="mdi:content-copy" class="copy-icon w-4 h-4" />
    <Icon name="mdi:check" class="copied-icon w-4 h-4" />
    <span class="copy-label" data-copied-label={t("common.copied")}>
      {t("common.copy")}
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch {
        return;
      }
      const label = btn.querySelector<HTMLElement>(".copy-label");
      const original = label?.textContent ?? "";
      btn.classList.add("is-copied");
      if (label) label.textContent = label.dataset.copiedLabel ?? original;
      setTimeout(() => {
        btn.classList.remove("is-copied");
        if (label) label.textContent = original;
      }, 1800);
    });
  });
</script>

<style>
  .copy-cmd {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--color-code-border));
    background: rgb(var(--color-code-bg));
    color: rgb(var(--color-text));
    font-family:
      ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .copy-prompt {
    padding-top: 0.2rem;
    color: rgb(var(--color-primary));
    user-select: none;
  }
  /* The whole command stays visible: it wraps rather than scrolling */
  .copy-text {
    flex: 1;
    min-width: 0;
    padding: 0.2rem 0;
    background: transparent;
    border: 0;
    color: inherit;
    font-size: inherit;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  .copy-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.375rem;
    border: 1px solid rgb(var(--color-code-border));
    background: rgb(var(--color-card-bg));
    color: rgb(var(--color-text-muted));
    font-family: "Atkinson", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .copy-btn:hover {
    color: rgb(var(--color-text));
    border-color: rgba(var(--color-brand), 0.5);
  }
  .copied-icon,
  .copy-btn.is-copied .copy-icon {
    display: none;
  }
  .copy-btn.is-copied .copied-icon {
    display: inline-block;
  }
  .copy-btn.is-copied {
    color: rgb(var(--color-success));
  }
  @media (max-width: 420px) {
    .copy-label {
      display: none;
    }
  }
</style>
