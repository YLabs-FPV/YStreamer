---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, getLocalizedUrl } from "../../i18n";
import { GITHUB_URL } from "../../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-6 pt-4 pb-20">
  <div class="card max-w-6xl mx-auto p-8 md:p-10 bg-[rgb(var(--color-secondary))] grid gap-6 md:grid-cols-[1fr_auto] items-center">
    <div>
      <h2 class="text-2xl md:text-3xl font-bold">{t("cta.title")}</h2>
      <p class="mt-2 text-[rgb(var(--color-text-muted))] max-w-xl">
        {t("cta.text")}
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href={getLocalizedUrl(lang, "/download")} class="btn btn-primary">
        <Icon name="mdi:download" class="w-5 h-5" />
        {t("cta.download")}
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="btn btn-ghost bg-[rgb(var(--color-card-bg))]"
      >
        <Icon name="mdi:github" class="w-5 h-5" />
        {t("cta.star")}
      </a>
    </div>
  </div>
</section>
