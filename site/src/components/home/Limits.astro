---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, useData } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = useData(lang);

const icons = [
  "mdi:raspberry-pi",
  "mdi:usb-port",
  "mdi:wifi",
  "mdi:monitor-off",
];
const items = d<{ title: string; text: string }[]>("limits.items");
---

<section class="px-6 py-12 md:py-16" id="good-to-know">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto">
      <span class="eyebrow">{t("limits.eyebrow")}</span>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold">{t("limits.title")}</h2>
      <p class="mt-3 text-[rgb(var(--color-text-muted))] text-lg">
        {t("limits.subtitle")}
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => (
        <div class="card p-6">
          <span class="icon-tile">
            <Icon name={icons[i]} class="w-6 h-6" />
          </span>
          <h3 class="mt-5 font-bold text-lg leading-snug">{item.title}</h3>
          <p class="mt-2 text-sm text-[rgb(var(--color-text-muted))]">
            {item.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
