---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, useData } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = useData(lang);

type Device = {
  name: string;
  via: string;
  kind: "goggles" | "camera";
  status: "supported" | "experimental";
};
const devices = d<Device[]>("compat.devices");
---

<section class="px-6 py-12" id="compatibility">
  <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] items-start">
    <div class="text-center lg:text-left">
      <span class="eyebrow">{t("compat.eyebrow")}</span>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold">{t("compat.title")}</h2>
      <p class="mt-3 text-[rgb(var(--color-text-muted))] text-lg">
        {t("compat.subtitle")}
      </p>
      <p class="mt-6 text-sm text-[rgb(var(--color-text-light))]">
        {t("compat.disclaimer")}
      </p>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2">
      {devices.map((dev) => (
        <li class="card flex items-start gap-3 p-4">
          <span class="icon-tile flex-none w-10! h-10!">
            <Icon
              name={dev.kind === "camera" ? "mdi:webcam" : "mdi:safety-goggles"}
              class="w-5 h-5"
            />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-semibold leading-snug">{dev.name}</span>
            <span class="mt-1 flex flex-wrap items-center gap-2 text-xs">
              <span class="text-[rgb(var(--color-text-muted))]">{dev.via}</span>
              <span
                class:list={[
                  "status",
                  dev.status === "experimental" ? "status-exp" : "status-ok",
                ]}
              >
                {t(`compat.status.${dev.status}`)}
              </span>
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.05rem 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
  }
  .status::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: currentColor;
  }
  .status-ok {
    color: rgb(var(--color-success));
    background: rgba(var(--color-success), 0.12);
  }
  .status-exp {
    color: rgb(var(--color-accent));
    background: rgba(var(--color-accent), 0.12);
  }
</style>
