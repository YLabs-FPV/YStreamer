---
// Dynamic locale redirect for ANY un-prefixed path
export const prerender = false;

import { languages, defaultLang, type Language } from "../i18n";

const path = Astro.url.pathname;

if (/\.[a-z0-9]+$/i.test(path)) {
  return new Response("Not found", { status: 404 });
}

const [first] = path.split("/").filter(Boolean);

if (first && first in languages) {
  return Astro.rewrite("/404");
}

const stored = Astro.cookies.get("preferred-language")?.value;
let target: Language | null =
  stored && stored in languages ? (stored as Language) : null;
if (!target) {
  const header = Astro.request.headers.get("accept-language") ?? "";
  target =
    (header
      .split(",")
      .map((l) => l.split(";")[0].trim().toLowerCase().split("-")[0])
      .find((l) => l in languages) as Language | undefined) ?? null;
}
target = target ?? defaultLang;

const dest = `/${target}${path}${path.endsWith("/") ? "" : "/"}${Astro.url.search}`;
return Astro.redirect(dest, 302);
---
