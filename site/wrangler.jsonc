{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "ystreamer",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the worker BEFORE serving assets for the un-prefixed entry paths so
    // the on-demand [...path] page renders and can locale-detect.
    // /install.sh and /update/manifest.json have no asset behind them, so they
    // fall through to the worker anyway (see src/pages/install.sh.ts).
    "run_worker_first": ["/download", "/download/", "/docs", "/docs/*"],
  },
  "observability": {
    "enabled": true,
  },
}
